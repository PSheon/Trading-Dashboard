# Orbie environment. Copy to `.env` at the repo root.
# One file for everything: the api and worker read all of it; the web reads
# only the NEXT_ keys. Never commit `.env`.
# On Railway set the same names per service (web: NEXT_ keys only).
# Local ports: web 3000 · api 3100 · worker 3010.

# --- DATABASE_ --------------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/trading_dashboard
# Tests use their own disposable database, never DATABASE_URL.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/trading_dashboard_test

# --- AUTH_ ------------------------------------------------------------------
# Server-to-server token. Never give it to the web.
AUTH_SERVICE_TOKEN=
# Permissions of that token, comma-separated (empty = none).
AUTH_SERVICE_PERMISSIONS=
# Emails that become admin on first sign-in, comma-separated.
AUTH_ADMIN_EMAILS=

# --- PRIVY_ (sign-in and wallets) -------------------------------------------
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# ES256 public key from the Privy dashboard.
PRIVY_VERIFICATION_KEY=
# Copy execution signing. Set both or neither.
# PRIVY_AGENT_AUTHORIZATION_KEY=
# PRIVY_AGENT_WORKER_QUORUM_ID=

# --- TELEGRAM_ (alerts bot) -------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=orbie_fun_bot
# Chat for system notices; empty = log only.
TELEGRAM_SYSTEM_CHAT_ID=
# true = log messages instead of sending.
TELEGRAM_DRY_RUN=true
# Only one process may poll the bot.
TELEGRAM_BOT_POLLING=true
# Site address used in bot links.
TELEGRAM_LINK_BASE_URL=https://app.orbie.fun

# --- ALERT_ -----------------------------------------------------------------
# Skip alerts for actions older than this.
ALERT_MAX_ACTION_AGE_SECONDS=120

# --- HYPERLIQUID_ -----------------------------------------------------------
# Market data always comes from mainnet.
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
# Same value in every process that shares one outbound IP.
HYPERLIQUID_EGRESS_KEY=trading-dashboard-shared-egress
# Request weight per minute and burst (Hyperliquid allows 1200/min per IP).
HYPERLIQUID_WEIGHT_BUDGET_PER_MIN=840
HYPERLIQUID_WEIGHT_BURST=200
# Share kept for page requests when busy (0.05–0.9).
HYPERLIQUID_PAGE_RESERVE_SHARE=0.25
# Slow start after a restart, in seconds (0 = off).
HYPERLIQUID_STARTUP_PACE_SECONDS=60
# Network for users' wallets: testnet or mainnet (mainnet = real funds).
HYPERLIQUID_NETWORK=testnet
# Arbitrum RPC for wallet balances; default is the public endpoint.
# HYPERLIQUID_ARBITRUM_RPC_URL=

# --- APP_ (process role and ports) ------------------------------------------
# combined = api + jobs in one process; api / worker = split.
APP_ROLE=combined
# Api port (Railway sets PORT itself).
# PORT=3100
# Worker port when it runs next to the api on one machine.
# WORKER_PORT=3010
# Needed when APP_ROLE=api. Railway: http://worker.railway.internal:3000
# WORKER_URL=http://127.0.0.1:3010

# --- API_ (limits and network) ----------------------------------------------
API_INGRESS_PER_MINUTE=3000
API_READ_PER_MINUTE=300
API_WRITE_PER_MINUTE=60
API_EXPENSIVE_PER_MINUTE=10
# Default when the admin setting is unset.
MAX_FAVORITES_PER_USER=100
# Proxies allowed to set the client address (Railway: fd12::/16).
API_TRUSTED_PROXY_CIDRS=
# Browser origins allowed to call the api directly; empty = none.
API_CORS_ORIGINS=

# --- STREAM_ (live feed connections) ----------------------------------------
STREAM_MAX_PER_IP=8
STREAM_MAX_TOTAL=500
# Proxy hops in front of the api (Railway: 1, local: 0).
STREAM_TRUSTED_PROXY_HOPS=0

# --- COPY_ ------------------------------------------------------------------
# paper (virtual funds, no orders sent) or disabled.
COPY_TRADING_MODE=paper
# How often the copy worker runs, in ms.
COPY_WORKER_INTERVAL_MS=2000

# --- S3_ARCHIVE_ (Hyperliquid fill history from S3) -------------------------
# true needs the AWS_ keys below.
S3_ARCHIVE_ENABLED=false
S3_ARCHIVE_BUCKET=hl-mainnet-node-data
S3_ARCHIVE_REGION=ap-northeast-1
# Earliest day the archive has.
S3_ARCHIVE_START=2025-05-25
# false = only new hours, no history.
S3_ARCHIVE_BACKFILL_ENABLED=true
S3_ARCHIVE_BACKFILL_DAYS=90
# Hours between history passes for newly tracked addresses.
S3_ARCHIVE_PASS_INTERVAL_HOURS=168
# Download spend cap per UTC day, and the price used to count it.
S3_ARCHIVE_MAX_DAILY_USD=2
S3_ARCHIVE_USD_PER_GB=0.114
S3_ARCHIVE_MAX_BYTES_PER_MINUTE=268435456
# Wait this long after an hour ends before reading it.
S3_ARCHIVE_SETTLE_MINUTES=20
# 0 = keep every address however busy.
S3_ARCHIVE_MAX_FILLS_PER_ADDRESS_HOUR=0
# REST history the archive may replace: regular, all or none.
S3_ARCHIVE_TRUST=regular
# Read archive files from a folder instead of S3 (tests).
# S3_ARCHIVE_LOCAL_DIR=

# --- AWS_ (pays for the S3 downloads; worker only) --------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- NEXT_ (web) ------------------------------------------------------------
# Web dev server port.
NEXT_PORT=3000
# Where the web forwards /api/hl/* to (server side only).
NEXT_API_URL=http://localhost:3100
# Header holding the visitor's address (Railway: x-real-ip).
# CLIENT_IP_HEADER=x-real-ip
# NEXT_PUBLIC_ values are visible in the browser.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_APP_NAME=Orbie
NEXT_PUBLIC_APP_URL=https://app.orbie.fun
# 1 = demo data instead of the api (dev and tests only).
# NEXT_PUBLIC_API_FIXTURES=1
# 1 = open the /dev lab in a production build.
# NEXT_DEV_LAB=1
# Extra Privy origins allowed by the CSP, comma-separated.
# NEXT_PRIVY_AUTH_ORIGINS=
