# Copy to .env (apps/api reads these at runtime) and fill in real values.
# apps/web needs its own NEXT_PUBLIC_-prefixed copies — see the bottom of
# this file — since Next.js only exposes env vars to the browser when
# they're prefixed that way.

# --- Postgres (Railway) ------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/trading_dashboard

# --- API auth (§8: single env token, no login system) ------------------
API_AUTH_TOKEN=change-me-to-a-long-random-string

# --- Telegram (§4.4 N1: two chats — realtime R1-R5, group R6-R9) -------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_REALTIME=
TELEGRAM_CHAT_ID_GROUP=

# --- Notify behavior (§11: DRY_RUN=true means notify only logs) --------
DRY_RUN=true

# --- N1: dashboard link embedded in every Telegram notification --------
DASHBOARD_BASE_URL=http://localhost:3001

# --- Hyperliquid public API (mainnet, read-only, no auth needed) -------
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# --- Watcher / W6 request budgeter (polling-only design, no WS — see
# watcher.service.ts and request-budgeter.service.ts for the arithmetic).
# Real HL limits verified 2026-09-29: 1200 weight/min/IP,
# clearinghouseState=2, userFillsByTime=20+~1/20 items. At 20s, 100
# addresses cost 600 weight/min for the base poll alone, leaving ~240/min
# of the 840 cap for delta-triggered userFillsByTime calls.
WATCHER_POLL_INTERVAL_SECONDS=20
HYPERLIQUID_WEIGHT_BUDGET_PER_MIN=840

# --- apps/web client-side copies ----------------------------------------
# NEXT_PUBLIC_API_URL should point at wherever apps/api is running
# (e.g. http://localhost:3000 locally, the Railway URL in production).
# NEXT_PUBLIC_API_AUTH_TOKEN must match API_AUTH_TOKEN above.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_AUTH_TOKEN=change-me-to-a-long-random-string
