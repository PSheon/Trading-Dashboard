# Orbie environment. Copy to .env at the repo root and fill in the values.
# - apps/api reads the whole file at startup (apps/api/src/main.ts).
# - apps/web takes only the NEXT_ block from it (apps/web/next.config.ts),
#   so the api's secrets never enter the web process.
# In production set the same names in the platform: Railway for apps/api
# (everything except NEXT_), Vercel for apps/web (the NEXT_ block only).
# Each block's variables share its prefix.

# --- DATABASE_ -------------------------------------------------------------
# Postgres. On Railway, reference the Postgres service's DATABASE_URL.
DATABASE_URL=postgres://user:password@localhost:5432/trading_dashboard
# Tests never use DATABASE_URL. Export TEST_DATABASE_URL explicitly when
# running tests; see apps/api/README.md for disposable PostgreSQL setup.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/trading_dashboard_test

# --- AUTH_ -----------------------------------------------------------------
# Server-to-server token. A request bearing it acts as the service caller,
# which receives ONLY AUTH_SERVICE_PERMISSIONS below. Empty disables service auth.
# Never give it to apps/web or a browser. Production/staging reject placeholder
# values and tokens shorter than 32 characters; generate with openssl rand -hex 32.
AUTH_SERVICE_TOKEN=
# Comma-separated explicit permissions. Empty = no administrative access.
# Example read-only integration: users.read,settings.read
# Full catalog and migration notes: docs/auth-and-config.md
AUTH_SERVICE_PERMISSIONS=
# Comma-separated emails (case-insensitive) bootstrapped as admin ONLY when
# creating a new local user from a verified Privy identity. Existing users are
# never promoted by this list: use an existing admin's user-management API.
# Removing an email does not demote an existing admin. A manual demotion stays.
AUTH_ADMIN_EMAILS=

# --- PRIVY_ ----------------------------------------------------------------
# From the Privy dashboard (App settings → Basics). Set both or neither.
# Both empty disables Privy sign-in; a partial pair fails startup.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: the app's verification key (the "-----BEGIN PUBLIC KEY-----"
# block, in double quotes). Verifies tokens locally instead of asking Privy.
PRIVY_VERIFICATION_KEY=

# --- TELEGRAM_ -------------------------------------------------------------
# The official bot (from @BotFather). Users link their chat to it from the
# site; alerts go to each user's own chat.
TELEGRAM_BOT_TOKEN=
# The bot's username without "@", used for t.me links.
TELEGRAM_BOT_USERNAME=orbie_fun_bot
# Chat for system messages only (e.g. trade feed down / recovered).
# Empty = system messages are only logged.
TELEGRAM_SYSTEM_CHAT_ID=
# true (the default) = alerts and system messages are logged instead of sent.
# The bot's own replies (linking a chat, /stop) are always sent.
TELEGRAM_DRY_RUN=true
# true (the default) = this process receives the bot's messages by long
# polling. Telegram allows one poller per token: set false on every other
# process using the same token (e.g. local dev next to production).
TELEGRAM_BOT_POLLING=true
# Site origin used for links inside messages, no trailing slash.
TELEGRAM_LINK_BASE_URL=https://app.orbie.fun

# --- ALERT_ ----------------------------------------------------------------
# Actions older than this (seconds) are stored but not alerted on.
ALERT_MAX_ACTION_AGE_SECONDS=120

# --- HYPERLIQUID_ ----------------------------------------------------------
# Public mainnet API, read-only, no auth needed.
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
# REST weight budget per minute: 70% of Hyperliquid's 1200/min per IP.
# Trades are discovered on the WebSocket feed (no weight); REST is spent on
# addresses that just traded, snapshots, sweeps, backfill and page loads.
HYPERLIQUID_WEIGHT_BUDGET_PER_MIN=840
# Token-bucket burst on top of that rate, so a cold page load doesn't wait
# behind even pacing. Capped so rate + burst stays under 1200/min.
HYPERLIQUID_WEIGHT_BURST=200

# --- STREAM_ ---------------------------------------------------------------
# GET /actions/stream (server-sent events pushed to open pages).
# Open streams per client address, and in the whole process; beyond → 429.
STREAM_MAX_PER_IP=8
STREAM_MAX_TOTAL=500
# Proxies in front of the api that each append one X-Forwarded-For entry,
# counting apps/web's /api/hl forwarder (it sets the browser's address).
# 0 = the socket's peer address (local dev: every browser counts as the web
# server). Behind Vercel → Railway: 2. Never set more than there are.
# Honoured only when the socket peer is in API_TRUSTED_PROXY_CIDRS below.
STREAM_TRUSTED_PROXY_HOPS=0

# --- NEXT_ (apps/web) ------------------------------------------------------
# Server-only: where apps/web forwards /api/hl/* to. The browser's own Privy
# token is passed through; apps/web never sends AUTH_SERVICE_TOKEN.
NEXT_API_URL=http://localhost:3000
# Public by design (inlined into the browser bundle).
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_APP_NAME=Orbie
NEXT_PUBLIC_APP_URL=https://app.orbie.fun
# Dev only: 1 answers every api call from apps/web/src/fixtures. A production
# build or server refuses to start with it.
# NEXT_PUBLIC_API_FIXTURES=1
# Server-only, read at run time by the CSP (apps/web/src/lib/csp.ts): extra
# Privy custom auth domains (https origins, comma-separated) the login iframe
# and Privy API use. privy.orbie.fun and privy.stage.orbie.fun are built in.
# NEXT_PRIVY_AUTH_ORIGINS=

# --- Inbound request limits / monitoring quota -----------------------------
# Per-process windows; see docs/rate-limits.md before scaling or proxy changes.
API_INGRESS_PER_MINUTE=3000
API_READ_PER_MINUTE=300
API_WRITE_PER_MINUTE=60
API_EXPENSIVE_PER_MINUTE=10
MAX_FAVORITES_PER_USER=100
# Explicit trusted immediate proxy IPs/CIDRs only. Empty trusts no forwarded IPs.
API_TRUSTED_PROXY_CIDRS=
# Exact browser origins allowed to call the API directly (no trailing slash).
# Same-origin Next proxy needs no entry; empty grants no cross-origin browser reads.
API_CORS_ORIGINS=
