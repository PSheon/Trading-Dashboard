# Helius: https://dashboard.helius.dev (Parsed Events API, 10 credits / request)
HELIUS_API_KEY=
# Dune: https://dune.com/settings/api (token creation / graduation times)
DUNE_API_KEY=
# Where raw responses, the warehouse and notes go (default: ./data)
# DATA_DIR=

# Web server
# APP_PASSWORD=            required in production; HTTP Basic, any username
# SCHEDULE_UTC=00:15       run the daily job at this UTC time inside the server
# ALLOW_NO_PASSWORD=1      only for a local production build

# Stop fetching once a run has spent this many Helius credits (default 200000)
# CREDIT_BUDGET_PER_RUN=200000
