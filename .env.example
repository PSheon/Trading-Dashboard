# Copy to .env (apps/api reads these at runtime) and fill in real values.
# apps/web's variables are at the bottom of this file; for local dev put
# them in apps/web/.env.local, on Vercel in the project's environment
# variables.

# --- Postgres (Railway) ------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/trading_dashboard

# --- API auth ------------------------------------------------------------
# Server-to-server token (never sent to a browser). A request bearing it
# acts as the service caller, which counts as admin.
API_AUTH_TOKEN=change-me-to-a-long-random-string

# --- Privy sign-in (Stage 2 §3) -----------------------------------------
# From the Privy dashboard (App settings → Basics). With either unset,
# Privy tokens are rejected (fail closed); public routes still work.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: the app's verification key (the PEM "-----BEGIN PUBLIC KEY-----"
# block, newlines as \n). Verifies tokens locally instead of fetching the
# app's JWKS from Privy.
PRIVY_VERIFICATION_KEY=
# Comma-separated emails that are made admin on their first sign-in
# (case-insensitive). Later role changes are made in the database.
BOOTSTRAP_ADMIN_EMAILS=

# --- Telegram ------------------------------------------------------------
# User alerts go to each user's own chat (set in the dashboard →
# notification settings). The chat ids below only receive system messages
# (e.g. trade feed down / recovered).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_REALTIME=
TELEGRAM_CHAT_ID_GROUP=

# --- Notify behavior (§11: DRY_RUN=true means notify only logs) --------
DRY_RUN=true

# --- N1: dashboard link embedded in every Telegram notification --------
DASHBOARD_BASE_URL=http://localhost:3001

# --- Hyperliquid public API (mainnet, read-only, no auth needed) -------
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# --- Watcher / W6 request budgeter --------------------------------------
# Trades are discovered on the `trades` WebSocket feed (no REST weight);
# REST is spent only on addresses that just traded, the 5-minute snapshots,
# the hourly sweep and A5 backfill. Budget default = 70% of Hyperliquid's
# 1200 weight/min per IP (PRD §8).
HYPERLIQUID_WEIGHT_BUDGET_PER_MIN=840
# Token-bucket burst on top of that rate, so a cold page load doesn't wait
# behind even pacing. Capped so rate + burst stays under 1200/min.
HYPERLIQUID_WEIGHT_BURST=200
# Actions older than this (seconds) are stored but not alerted on.
ALERT_MAX_ACTION_AGE_SECONDS=120

# --- apps/web ------------------------------------------------------------
# Server-only: apps/web forwards /api/hl/* to API_URL, passing the browser's
# own Privy token through. It never sends API_AUTH_TOKEN, so apps/web
# doesn't need it.
API_URL=http://localhost:3000
# Public (inlined into the browser bundle by design):
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_APP_NAME=Orbie
NEXT_PUBLIC_APP_URL=https://app.orbie.fun
# Dev only: 1 answers every api call from apps/web/src/fixtures.
# NEXT_PUBLIC_API_FIXTURES=1
