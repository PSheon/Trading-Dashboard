{
  "name": "trading-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @trading-dashboard/shared db:generate",
    "db:migrate": "pnpm --filter @trading-dashboard/shared db:migrate",
    "test": "pnpm test:api:isolated && pnpm --filter @trading-dashboard/web test",
    "test:api:isolated": "node scripts/test-api-isolated.mjs",
    "test:bootstrap": "pnpm --filter @trading-dashboard/shared build && pnpm --filter @trading-dashboard/api build && node scripts/bootstrap-smoke.mjs",
    "compare:copydog": "pnpm --filter @trading-dashboard/shared build && pnpm --filter @trading-dashboard/api build && node scripts/compare-copydog.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
