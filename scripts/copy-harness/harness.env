# Copy harness profile for the local api and worker (scripts/copy-harness/stack.mjs).
# Layered over the repo-root .env: values here win (process.loadEnvFile never
# overrides what the environment already has). No secrets here.

# Both processes: real testnet copies (the root .env says paper).
COPY_TRADING_MODE=testnet

# Worker: read a testnet leader every 2 s instead of every 60 s (workstream ②'s
# knob; an older build ignores it), and one live pass a second.
COPY_LIVE_TESTNET_SOURCE_INTERVAL_MS=2000
COPY_LIVE_INTERVAL_MS=1000
