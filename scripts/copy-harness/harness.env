# Copy harness profile for the local api and worker (scripts/copy-harness/stack.mjs).
# Layered over the repo-root .env: values here win (process.loadEnvFile never
# overrides what the environment already has). No secrets here.

# Both processes: real testnet copies (the root .env says paper); testnet
# copies need the deployment's network to be testnet.
COPY_TRADING_MODE=testnet
HYPERLIQUID_NETWORK=testnet

# Local operational throughput only; stage-caps.env still fixes every
# financial cap. At two mandatory list reads (at least 40 weight), polling
# every 3 seconds needs 800/min before orders or settlement. Use the normal
# 60-second source cadence and a 400/min wallet bucket (800 burst), which
# retains room for the maximum two accounts plus leader evidence (793).
# The shared 1200/min per-IP meter and all evidence deadlines remain intact.
COPY_LIVE_TESTNET_SOURCE_INTERVAL_MS=60000
COPY_LIVE_WEIGHT_PER_MIN=400
# One live work pass a second; source polling has its own cadence above.
COPY_LIVE_INTERVAL_MS=1000
