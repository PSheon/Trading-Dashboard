# Copy harness profile `ratio-floor`: the planned mainnet functional test
# over harness.env (node scripts/copy-harness/stack.mjs restart worker
# --profile ratio-floor, and the same for api; run.mjs --profile ratio-floor).
# Ratio sizing, 50 USDC a copy, leverage 3, and the TEST ONLY minimum floor:
# a ratio open under 10 USD is raised to it (at most 15). No secrets here.
COPY_LIVE_MAX_LEVERAGE=3
COPY_LIVE_MAX_ALLOCATION_USD=50
COPY_LIVE_MAX_STRATEGIES_PER_USER=2
COPY_LIVE_TEST_MIN_FLOOR_MAX_USD=15
