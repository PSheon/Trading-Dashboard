# Copy harness profile `ratio-floor`: the mainnet functional test over
# harness.env (node scripts/copy-harness/stack.mjs restart worker
# --profile ratio-floor, and the same for api; run.mjs --profile ratio-floor).
# Ratio sizing, 50 USDC a copy, leverage 3. A ratio open under the 10 USD
# order minimum is refused (below_min_notional), never raised: the TEST ONLY
# floor (COPY_LIVE_TEST_MIN_FLOOR_MAX_USD) was retired (D6, 2026-10-23). No secrets here.
COPY_LIVE_MAX_LEVERAGE=3
COPY_LIVE_MAX_ALLOCATION_USD=50
COPY_LIVE_MAX_STRATEGIES_PER_USER=2
# The wallet bucket at Stage mainnet's live bucket: 300/min, burst 900.
COPY_LIVE_WEIGHT_PER_MIN=300
# As on Stage: every mainnet leader is read by the fast source.
COPY_LIVE_FAST_SOURCE=all
