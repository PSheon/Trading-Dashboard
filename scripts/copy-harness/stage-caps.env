# Copy harness profile `stage-caps`: Stage's caps over harness.env
# (node scripts/copy-harness/stack.mjs restart worker --profile stage-caps,
# and the same for api; run.mjs --profile stage-caps). No secrets here.
COPY_LIVE_MAX_LEVERAGE=3
COPY_LIVE_FIXED_PER_TRADE_MIN_USD=12
COPY_LIVE_FIXED_PER_TRADE_MAX_USD=15
COPY_LIVE_MAX_ALLOCATION_USD=50
COPY_LIVE_MAX_STRATEGIES_PER_USER=2
