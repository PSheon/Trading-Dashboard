# Copy harness profile `stage-like`: ratio-floor.env, then this file (stack.mjs
# layers both over harness.env). The pre-mainnet gate runs on it
# (node scripts/copy-harness/stack.mjs restart worker --profile stage-like, the
# same for api; run.mjs --profile stage-like). No secrets here.
#
# TEST ONLY: every SQL statement of the api and the worker waits 8 ms first,
# Stage's round trip to its Postgres (db-rtt.mjs; stack.mjs loads it with
# `node --import`). Local Postgres answers in ~0 ms, so without it an order's
# meter transactions never cost the seconds they cost on Stage.
COPY_HARNESS_DB_RTT_MS=8
# As on Stage (also in ratio-floor.env): every mainnet leader on the fast source.
COPY_LIVE_FAST_SOURCE=all
# TEST ONLY, TESTNET ONLY: the live path's evidence window, 7000 ms instead of
# 5000 (COPY_LIVE_TESTNET_EVIDENCE_MAX_AGE_MS; approved by Paul 2026-10-16).
# Testnet lists 273 perp dexes (mainnet 11): the dex fan-out alone took
# 1.5–1.6 s (17.7 ms/dex) and raw order evidence 4.7–5.1 s (gate 11,
# 2026-10-16), so every attempt was live_risk_stale and the setup's
# account-mode evidence expired. Mainnet stays 5000: the api and the worker
# refuse to start with this set on a mainnet HYPERLIQUID_NETWORK. The gate's
# judged-evidence limit (< 3500 ms, criteria.mjs) is unchanged, and the summary
# prints the window in force beside every evidence figure. Never copy this to
# Stage or production: harness profiles are read by stack.mjs only.
COPY_LIVE_TESTNET_EVIDENCE_MAX_AGE_MS=7000
